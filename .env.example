# Copy to .env and fill in. .env is never committed.

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for the demo accounts, 8 to 72 bytes. Read on the first start only.
SEED_PASSWORD=

# true only when served over HTTPS
SESSION_COOKIE_SECURE=false

# Only the assistant needs this
OPENROUTER_API_KEY=
