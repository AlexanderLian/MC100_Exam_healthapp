# Copy to .env and fill in. .env is never committed.

# Signs the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Password for all seeded demo accounts, 8 to 72 bytes. Only read on the first start, when healthapp.db is created.
SEED_PASSWORD=

# true only when served over HTTPS
SESSION_COOKIE_SECURE=false
